# Copy to .env.local and fill in. .env.local is gitignored.

# --- RawTree (Tinybird): required. Everything the desk sees, does and says lives here.
RAWTREE_API_KEY=
# Use a dedicated database; shared keys may already have other projects in "default".
RAWTREE_DATABASE=breakout

# --- GitHub: optional if the GitHub CLI is logged in (`gh auth login`), otherwise a classic token.
GITHUB_TOKEN=

# --- Nimble: web research (Web Search Agents) and the web tools in Ask the desk.
NIMBLE_API_KEY=
# low = 10-30s per story (best for live demos), medium = 1-3 min
NIMBLE_EFFORT=low
NIMBLE_AGENT_NAME=breakout-desk

# --- Black Forest Labs: FLUX 3 anchor bulletins and the FLUX.2 studio still.
BFL_API_KEY=
# Drafts are about 1/3 the price and ~60s; promote the keepers with "Render final cut".
FLUX_DRAFT=true
FLUX_DURATION=12
FLUX_RESOLUTION=hd

# --- Script writer and Ask the desk: any OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_STRUCTURED_OUTPUTS=true

# --- Liquid LFM2.5 on this machine (Ollama or llama.cpp server, OpenAI-compatible).
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF
LOCAL_LLM_LABEL=LFM2.5-1.2B

# --- Worker tuning
# Hours of the GH Archive firehose to load (newest first). 168 = a week, ~14M raw events.
BACKFILL_HOURS=168
AUTO_COVER=true
MAX_AUTO_BULLETINS_PER_HOUR=3
MIN_STARS_1H=15
MIN_STARS_6H=40
COVER_COOLDOWN_HOURS=12
STORY_CONCURRENCY=2

# --- Demo video narration (scripts/demo-video)
ELEVENLABS_API_KEY=
